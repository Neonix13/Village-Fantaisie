<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pioche ton role</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="pioche-body">
  <div class="card">
    <p class="step">Etape 3 / 4 - Pioche des roles</p>
    <h1>Entre ton prenom</h1>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <% if (remaining <= 0) { %>
      <p class="warning">Tous les roles ont deja ete distribues.</p>
      <a class="btn big" href="/admin/<%= party.id %>/<%= party.admin_token %>">Retour au tableau de bord MJ</a>
    <% } else { %>
      <form method="POST" action="/pioche/<%= party.id %>">
        <input type="text" name="name" placeholder="Ton prenom" required autofocus>
        <button class="btn big" type="submit">Piocher mon role</button>
      </form>
      <p class="hint"><%= remaining %> role(s) restant(s) a piocher.</p>
    <% } %>
  </div>
</body>
</html>
