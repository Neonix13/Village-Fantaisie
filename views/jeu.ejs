<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#100e17">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Fantaisy">
  <title>Village & Fantaisy</title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/png" href="/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="stylesheet" href="/jeu.css">
</head>
<body>
  <div id="app"></div>
  <script>
    window.VF_ROLES = <%- rolesJson %>;
    window.VF_PRIORITY = <%- priorityJson %>;
    window.VF_BADGES = <%- badgesJson %>;
  </script>
  <script src="/jeu.js"></script>
  <script>
    // PWA : lancement hors-ligne (HTTPS ou localhost requis). Inutile dans la coquille native.
    if ('serviceWorker' in navigator && !window.Capacitor) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js').catch(function () { /* ignore */ });
      });
    }
  </script>
</body>
</html>
