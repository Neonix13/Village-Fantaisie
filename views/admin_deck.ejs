<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Composition du deck</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="card">
    <p class="step">Etape 2 / 4 - Personnalisation du deck</p>
    <h1>Composition du deck (<%= party.expected_players %> joueurs)</h1>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <form method="POST" action="/admin/<%= party.id %>/<%= party.admin_token %>/deck" id="deck-form">
      <div class="mode-toggle">
        <label><input type="radio" name="mode" value="simple" <%= mode === 'simple' ? 'checked' : '' %>> Simplifie</label>
        <label><input type="radio" name="mode" value="detaille" <%= mode === 'detaille' ? 'checked' : '' %>> Detaille</label>
      </div>

      <div id="simple-panel">
        <label for="villain_target">Nombre de Vilains (au hasard parmi les roles Vilains)</label>
        <input type="number" id="villain_target" name="villain_target" min="0" max="30" value="<%= villainTarget %>">
        <p class="hint">Soldat et Demon ont un compteur (defaut suggere : 2), les autres roles sont a cocher.</p>

        <p class="hint">Personnages garantis dans la partie (le reste des places est comble par des Villageois) :</p>
        <div class="deck-columns">
          <div class="deck-col">
            <h3 class="camp-royaume">Royaume</h3>
            <% rolesByCamp.royaume.forEach(function(role) { %>
              <% if (pairRoles.has(role.id)) { %>
                <div class="count-row">
                  <span><%= role.name %></span>
                  <div class="stepper">
                    <button class="btn small step-btn" type="button" data-step="-1">-</button>
                    <input type="number" name="count_<%= role.id %>" min="0" max="10" value="<%= customCounts[role.id] || 0 %>">
                    <button class="btn small step-btn" type="button" data-step="1">+</button>
                  </div>
                </div>
              <% } else { %>
                <label class="count-row">
                  <span><%= role.name %></span>
                  <input type="checkbox" name="guarantee_<%= role.id %>" <%= guaranteedRoleIds.includes(role.id) ? 'checked' : '' %>>
                </label>
              <% } %>
            <% }) %>
          </div>
          <div class="deck-col">
            <h3 class="camp-vilains">Vilains</h3>
            <% rolesByCamp.vilains.forEach(function(role) { %>
              <% if (pairRoles.has(role.id)) { %>
                <div class="count-row">
                  <span><%= role.name %></span>
                  <div class="stepper">
                    <button class="btn small step-btn" type="button" data-step="-1">-</button>
                    <input type="number" name="count_<%= role.id %>" min="0" max="10" value="<%= customCounts[role.id] || 0 %>">
                    <button class="btn small step-btn" type="button" data-step="1">+</button>
                  </div>
                </div>
              <% } else { %>
                <label class="count-row">
                  <span><%= role.name %></span>
                  <input type="checkbox" name="guarantee_<%= role.id %>" <%= guaranteedRoleIds.includes(role.id) ? 'checked' : '' %>>
                </label>
              <% } %>
            <% }) %>
          </div>
        </div>
        <h3 class="camp-autres">Les autres</h3>
        <% rolesByCamp.autres.forEach(function(role) { %>
          <label class="count-row">
            <span><%= role.name %></span>
            <input type="checkbox" name="guarantee_<%= role.id %>" <%= guaranteedRoleIds.includes(role.id) ? 'checked' : '' %>>
          </label>
        <% }) %>
      </div>

      <div id="detaille-panel" hidden>
        <p class="hint">Nombre exact d'exemplaires de chaque role (0 = absent).</p>
        <div class="deck-columns">
          <div class="deck-col">
            <h3 class="camp-royaume">Royaume</h3>
            <% rolesByCamp.royaume.forEach(function(role) { %>
              <div class="count-row">
                <span><%= role.name %></span>
                <div class="stepper">
                  <button class="btn small step-btn" type="button" data-step="-1">-</button>
                  <input type="number" name="count_<%= role.id %>" min="0" max="10" value="<%= customCounts[role.id] || 0 %>">
                  <button class="btn small step-btn" type="button" data-step="1">+</button>
                </div>
              </div>
            <% }) %>
          </div>
          <div class="deck-col">
            <h3 class="camp-vilains">Vilains</h3>
            <% rolesByCamp.vilains.forEach(function(role) { %>
              <div class="count-row">
                <span><%= role.name %></span>
                <div class="stepper">
                  <button class="btn small step-btn" type="button" data-step="-1">-</button>
                  <input type="number" name="count_<%= role.id %>" min="0" max="10" value="<%= customCounts[role.id] || 0 %>">
                  <button class="btn small step-btn" type="button" data-step="1">+</button>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
        <h3 class="camp-autres">Les autres</h3>
        <% rolesByCamp.autres.forEach(function(role) { %>
          <div class="count-row">
            <span><%= role.name %></span>
            <div class="stepper">
              <button class="btn small step-btn" type="button" data-step="-1">-</button>
              <input type="number" name="count_<%= role.id %>" min="0" max="10" value="<%= customCounts[role.id] || 0 %>">
              <button class="btn small step-btn" type="button" data-step="1">+</button>
            </div>
          </div>
        <% }) %>
      </div>

      <button class="btn big" type="submit">Generer le deck</button>
    </form>
  </div>
  <script src="/app.js"></script>
</body>
</html>
