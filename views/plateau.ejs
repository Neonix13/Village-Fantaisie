<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="refresh" content="5">
  <title>Plateau - Village et Fantaisy</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="card">
    <h1>Plateau</h1>
    <ul class="board">
      <% players.forEach(function(p) { %>
        <li class="<%= p.alive ? 'alive' : 'dead' %>"><%= p.name %></li>
      <% }) %>
    </ul>
  </div>
</body>
</html>
