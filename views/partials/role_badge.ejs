<%
// Partial : blason en SVG pur (pas d'emoji, pas de fichier image) pour un role.
// Usage : include('partials/role_badge', { role: role, size: 'lg' })
// `size` : 'sm' (defaut), 'md' ou 'lg'.
const badgeSize = typeof size !== 'undefined' ? size : 'sm';
%>
<svg class="role-badge role-badge-<%= badgeSize %> camp-<%= role.camp %>" viewBox="0 0 48 58" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="<%= role.name %>">
  <path class="role-badge-frame" d="M2 2 H46 V38 L24 56 L2 38 Z"/>
  <g class="role-badge-icon">
    <% if (role.id === 'roi') { %>
      <path d="M9 32 L7 15 L16 23 L24 10 L32 23 L41 15 L39 32 Z"/>
      <circle cx="7" cy="13" r="2.4"/>
      <circle cx="24" cy="8" r="2.6"/>
      <circle cx="41" cy="13" r="2.4"/>
      <rect x="9" y="33.5" width="30" height="7" rx="2"/>
      <circle class="role-badge-cut" cx="16" cy="37" r="1.7"/>
      <circle class="role-badge-cut" cx="24" cy="37" r="1.7"/>
      <circle class="role-badge-cut" cx="32" cy="37" r="1.7"/>
    <% } else if (role.id === 'herault') { %>
      <path d="M9.5 38.5 C6 23 17 9 35.5 7.5 L42 21 C30 21.5 21 28.5 15.5 41 Z"/>
      <ellipse cx="38.8" cy="14.3" rx="3.8" ry="8.4" transform="rotate(-26.6 38.8 14.3)"/>
      <ellipse class="role-badge-cut" cx="39.2" cy="14.3" rx="2" ry="6.4" transform="rotate(-26.6 39.2 14.3)"/>
      <path class="role-badge-cut" d="M17.5 28.5 L23.5 32 L22.6 33.8 L16.6 30.2 Z"/>
      <path class="role-badge-cut" d="M24.5 19.8 L30 22.6 L29.2 24.4 L23.6 21.6 Z"/>
      <circle cx="12.6" cy="41" r="3"/>
      <circle class="role-badge-cut" cx="12.6" cy="41" r="1.2"/>
    <% } else if (role.id === 'chaman') { %>
      <path d="M24 6 C34 6 38 15 37 25 C36 34 30 42 24 43 C18 42 12 34 11 25 C10 15 14 6 24 6 Z"/>
      <path d="M17 7 L13 2 L20 5 Z"/>
      <path d="M31 7 L35 2 L28 5 Z"/>
      <path class="role-badge-cut" d="M14.5 21 Q18.5 17.5 22 21.5 Q18 23.5 14.5 21 Z"/>
      <path class="role-badge-cut" d="M33.5 21 Q29.5 17.5 26 21.5 Q30 23.5 33.5 21 Z"/>
      <path class="role-badge-cut" d="M24 22 L26.4 31 L21.6 31 Z"/>
      <rect class="role-badge-cut" x="18.5" y="35" width="11" height="2.6" rx="1.3"/>
      <path class="role-badge-cut" d="M24 10 L26.2 14 L24 18 L21.8 14 Z"/>
      <path class="role-badge-cut" d="M13.5 27 L18 28.5 M34.5 27 L30 28.5" stroke-width="0"/>
      <circle class="role-badge-cut" cx="15.5" cy="28.5" r="1.3"/>
      <circle class="role-badge-cut" cx="32.5" cy="28.5" r="1.3"/>
    <% } else if (role.id === 'villageois') { %>
      <circle cx="24" cy="14" r="7"/>
      <path d="M11 40 Q11 24 24 24 Q37 24 37 40 Z"/>
    <% } else if (role.id === 'soldat') { %>
      <path d="M24 4 L27.6 8.5 L27.6 30 L20.4 30 L20.4 8.5 Z"/>
      <rect class="role-badge-cut" x="23.3" y="10" width="1.4" height="17" rx="0.7"/>
      <rect x="12" y="30" width="24" height="4" rx="2"/>
      <rect x="22.2" y="34" width="3.6" height="7" rx="1"/>
      <circle cx="24" cy="43" r="2.8"/>
    <% } else if (role.id === 'licorne') { %>
      <path d="M13 41 C10 32 11 23 17 18 L17.5 10 L22 15.5 C24.5 15 27 16 28.5 18 L38 31 C40 34 39 38 35 39.5 L31 39 C27.5 39.5 26 44 22 44 Z"/>
      <path d="M25 16.5 L33.4 2 L30.8 18.6 Z"/>
      <path class="role-badge-cut" d="M27.1 12.9 L32.3 11.3 L32.1 12.9 L26.6 14.6 Z"/>
      <path class="role-badge-cut" d="M29.6 7.9 L33 7 L32.8 8.5 L29 9.5 Z"/>
      <circle class="role-badge-cut" cx="25.5" cy="26" r="1.7"/>
      <ellipse class="role-badge-cut" cx="36" cy="34.5" rx="1.1" ry="1.7" transform="rotate(40 36 34.5)"/>
    <% } else if (role.id === 'fee') { %>
      <path d="M24 8 L28 19 L40 19 L30 26 L34 38 L24 31 L14 38 L18 26 L8 19 L20 19 Z"/>
    <% } else if (role.id === 'pretre') { %>
      <circle cx="24" cy="24" r="15"/>
      <rect class="role-badge-cut" x="21" y="10" width="6" height="28"/>
      <rect class="role-badge-cut" x="10" y="21" width="28" height="6"/>
    <% } else if (role.id === 'diable') { %>
      <path d="M21 42 C5 41 1.5 22 8 4.5 C10.5 20 14.5 33 21 42 Z"/>
      <path d="M27 42 C43 41 46.5 22 40 4.5 C37.5 20 33.5 33 27 42 Z"/>
    <% } else if (role.id === 'demon') { %>
      <path d="M24 4 C26.5 11.5 36.5 16.5 36.5 28 C36.5 36.5 31 42.5 24 42.5 C17 42.5 11.5 36.5 11.5 28 C11.5 22.5 14.5 19 17.5 16 C17.8 20.5 19.5 22.8 22 23.2 C20 16 21 9.5 24 4 Z"/>
      <path class="role-badge-cut" d="M24 26.5 C27 30.5 30 32.5 30 36 C30 39 27.5 40.5 24 40.5 C20.5 40.5 18 39 18 36 C18 32.5 21 30.5 24 26.5 Z"/>
    <% } else if (role.id === 'vampire') { %>
      <path d="M14 14 H34 L29 28 L24 19 L19 28 Z"/>
    <% } else if (role.id === 'sorciere') { %>
      <path d="M24 6 L35 34 H13 Z"/>
      <ellipse cx="24" cy="34" rx="15" ry="4.5"/>
      <circle class="role-badge-cut" cx="24" cy="19" r="2.4"/>
    <% } else if (role.id === 'rejeton_vampire') { %>
      <path d="M24 9 C33 22 35 30 24 39 C13 30 15 22 24 9 Z"/>
    <% } else if (role.id === 'loup_garou') { %>
      <path d="M24 24.5 C30.5 24.5 36 30.5 36 36 C36 40.5 32 42 28.5 40.6 C26.6 39.9 25.4 39.6 24 39.6 C22.6 39.6 21.4 39.9 19.5 40.6 C16 42 12 40.5 12 36 C12 30.5 17.5 24.5 24 24.5 Z"/>
      <ellipse cx="10.5" cy="22" rx="3.5" ry="5.2" transform="rotate(-28 10.5 22)"/>
      <ellipse cx="18.3" cy="13.5" rx="3.6" ry="5.6" transform="rotate(-9 18.3 13.5)"/>
      <ellipse cx="29.7" cy="13.5" rx="3.6" ry="5.6" transform="rotate(9 29.7 13.5)"/>
      <ellipse cx="37.5" cy="22" rx="3.5" ry="5.2" transform="rotate(28 37.5 22)"/>
      <path d="M7 15.5 L8.4 19 L10.6 16.6 Z"/>
      <path d="M16.2 6.2 L17.2 9.8 L19.6 7.6 Z"/>
      <path d="M31.8 6.2 L30.8 9.8 L28.4 7.6 Z"/>
      <path d="M41 15.5 L39.6 19 L37.4 16.6 Z"/>
    <% } else if (role.id === 'succube') { %>
      <path d="M24 38 C6 25 11 6 24 15 C37 6 42 25 24 38 Z"/>
    <% } else if (role.id === 'voleur') { %>
      <path d="M8 18 Q24 8 40 18 Q40 28 24 28 Q8 28 8 18 Z"/>
      <circle class="role-badge-cut" cx="16" cy="19" r="3.4"/>
      <circle class="role-badge-cut" cx="32" cy="19" r="3.4"/>
    <% } else if (role.id === 'espion') { %>
      <circle cx="19" cy="19" r="10"/>
      <circle class="role-badge-cut" cx="19" cy="19" r="5.6"/>
      <line x1="27" y1="27" x2="39" y2="39" stroke-width="5.5" stroke-linecap="round"/>
    <% } %>
  </g>
</svg>
