<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ton role</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="pioche-body">
  <div class="card">
    <p class="hint"><%= name %></p>
    <h1 class="role-name-big"><%= role.name %></h1>
    <p class="power"><%= role.description %></p>
    <% if (role.item) { %>
      <p class="warning">Prends : <%= role.item %></p>
    <% } else if (boxNumber) { %>
      <p class="warning">Va chercher tes objets dans la boite n. <%= boxNumber %></p>
    <% } %>

    <a class="btn big" id="next-player" href="/pioche/<%= party.id %>">J'ai note, joueur suivant</a>
  </div>
  <script>
    setTimeout(function () {
      window.location.href = document.getElementById('next-player').href;
    }, 60000);
  </script>
</body>
</html>
