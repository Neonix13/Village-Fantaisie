<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Village & Fantaisy · Hôte</title>
  <style>
    :root { --bg: #100e17; --card: #1a1726; --border: #322d45; --text: #f1ece0; --muted: #9a94ab; --gold: #e3b25e; }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--text); font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; padding: 24px 16px 48px; }
    main { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }
    h1 { margin: 0; font-size: 26px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold); }
    p { margin: 0; line-height: 1.5; color: var(--muted); }
    .stats { display: flex; gap: 12px; flex-wrap: wrap; }
    .pill { border: 1px solid var(--border); border-radius: 999px; padding: 6px 14px; font-size: 14px; }
    .pill b { color: var(--gold); }
    .addr { display: flex; gap: 18px; align-items: center; background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 16px; flex-wrap: wrap; }
    .addr.main { border-color: var(--gold); }
    .qr { width: 168px; height: 168px; flex: none; background: #fff; border-radius: 8px; overflow: hidden; }
    .qr svg { width: 100%; height: 100%; display: block; }
    .addr h2 { margin: 0 0 4px; font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); }
    .url { font-size: 18px; font-weight: 700; word-break: break-all; margin: 6px 0; }
    .hint { border: 1px dashed var(--border); border-radius: 12px; padding: 14px 16px; font-size: 14px; }
    code { background: #241f33; padding: 2px 6px; border-radius: 6px; color: var(--text); }
    button { font: inherit; font-weight: 700; color: #ff8f8f; background: none; border: 1px solid #ff8f8f; border-radius: 10px; padding: 10px 16px; cursor: pointer; }
  </style>
</head>
<body>
  <main>
    <h1>Partie en cours</h1>
    <p>Chaque joueur scanne un de ces codes (ou tape l'adresse) : tous les téléphones jouent la même partie.</p>
    <div class="stats" id="stats"></div>
    <div id="addrs"></div>
    <div class="hint" id="tunnel-hint" hidden>
      Pour jouer <b>sans être sur le même wifi</b>, lance le serveur avec <code>npm run public</code> :
      une adresse internet apparaîtra ici (nécessite <code>cloudflared</code>, installé une seule fois :
      <code>winget install --id Cloudflare.cloudflared</code>).
    </div>
    <form method="post" action="/hote/reset" onsubmit="return confirm('Supprimer la partie en cours et recommencer ?')">
      <button type="submit">Nouvelle partie (efface tout)</button>
    </form>
  </main>
  <script>
    var PHASES = { setup: 'Mise en place', pioche: 'Pioche des cartes', hub: 'Partie en cours', recap: 'Fin de partie' };
    function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;'); }
    function tick() {
      fetch('/hote/info').then(function (r) { return r.json(); }).then(function (d) {
        document.getElementById('stats').innerHTML =
          '<span class="pill"><b>' + d.clients + '</b> téléphone(s) connecté(s)</span>' +
          '<span class="pill">' + PHASES[d.phase] + '</span>' +
          '<span class="pill"><b>' + d.players + '</b> / ' + d.count + ' joueurs</span>';
        document.getElementById('addrs').innerHTML = d.addresses.map(function (a, i) {
          return '<div class="addr' + (i === 0 ? ' main' : '') + '" style="margin-bottom:14px"><div class="qr">' + a.qr + '</div>' +
            '<div style="flex:1;min-width:200px"><h2>' + esc(a.label) + '</h2><div class="url">' + esc(a.url) + '</div><p>' + esc(a.note) + '</p></div></div>';
        }).join('');
        document.getElementById('tunnel-hint').hidden = d.tunnel === 'on';
      }).catch(function () {});
    }
    tick();
    setInterval(tick, 3000);
  </script>
</body>
</html>
